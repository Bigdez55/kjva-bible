{
  "name": "KJVA Bible",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend (FastAPI :8001)",
      "command": "cd backend && ../.venv/bin/uvicorn main:app --reload --port 8001"
    },
    {
      "name": "frontend (Vite :5173)",
      "command": "cd frontend && npm run dev -- --host"
    }
  ],
  "ports": [
    { "name": "backend", "port": 8001 },
    { "name": "frontend", "port": 5173 }
  ]
}
