# AI runtime state — block nested .claude/.codex per do_not_import_global_claude_codex_state policy.
# Root-level .claude/ and .codex/ are allowed (project commands + settings).
# The synced universal/ bundle is generated content — not tracked.
*/.claude/
*/.codex/
**/.gemini/
.claude/universal/
.codex/universal/

# Large adapter weights — tracked on disk + provenance JSON, not in git (matches gguf/safetensors policy)
*.npz

# Corpus v2 bulk data (~460MB) — rebuildable via the scripts/corpus/ pipeline;
# sha256 provenance tracked in data/corpus/external/fetch_manifest.json and
# data/corpus_v2/manifest.json. Manifests, validation report, and SOURCES.md ARE tracked.
data/corpus/external/scrollmapper/
data/corpus/external/ebible/
data/corpus/external/wesley_nnu/
data/corpus/external/archive_org/
data/corpus_v2/versions/
data/corpus_v2/corpus.txt
# KJVA replacement rollback assets — transient, never commit
KJVA_BACKUP_*/
KJVA_REPLACED_*/
KJVA_FAILED_REPLACEMENT_*/
KJVA_OLD_FILE_INVENTORY_*.txt

# atlas_tether: vendored corpus (replaced by thin tether)
atlas/
