      ],
      "produces": [
        "sentencepiece_tokenizer"
      ],
      "runner": {
        "kind": "script",
        "path": "ml-training/scripts/train_tokenizer.py"
      },
      "summary": "Train a byte-fallback BPE tokenizer from the local corpus."
    },
    {
      "id": "corpus.kjv_apocrypha",
      "name": "KJV + Apocrypha Corpus Builder",
      "family": "data",
      "status": "implemented",
