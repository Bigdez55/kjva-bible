{
  "registry_id": "tokenless_omni_training_registry_v1",
  "version": "2026-05-24",
  "purpose": "A universal registry of training programs that can be planned, validated, exported as a program corpus, and connected to concrete runners.",
  "compatibility_terms": {
    "scratch_model": "A model initialized randomly and trained without external pretrained weights.",
    "base_checkpoint": "A completed model checkpoint used as the starting point for fine-tuning, PEFT, preference training, or distillation.",
    "retrieval_first": "Exact factual answers must use retrieval/citation lookup instead of raw generation."
  },
  "methods": [
    {
      "id": "scratch.byte_lm",
      "name": "Byte-Level Tokenless Pretraining",
      "family": "from_scratch",
      "status": "implemented",
      "requires": [
        "corpus"
      ],
      "produces": [
        "base_checkpoint",
        "byte_vocab",
        "validation_report"
      ],
      "runner": {
        "kind": "script",
        "path": "ml-training/scripts/train_byte.py"
      },
      "summary": "Train TokenlessLM directly over UTF-8 byte ids with no tokenizer and no pretrained weights."
    },
    {
      "id": "scratch.bpe_lm",
      "name": "SentencePiece Byte-Fallback BPE Pretraining",
      "family": "from_scratch",
      "status": "implemented",
      "requires": [
        "corpus",
        "sentencepiece_tokenizer"
      ],
      "produces": [
        "base_checkpoint",
        "tokenizer_model",
        "validation_report"
      ],
      "runner": {
        "kind": "script",
        "path": "ml-training/scripts/train.py"
      },
      "summary": "Train TokenlessLM from random initialization with a byte-fallback BPE tokenizer baseline."
    },
    {
      "id": "tokenizer.sentencepiece_bpe",
      "name": "SentencePiece Tokenizer Training",
      "family": "tokenizer",
      "status": "implemented",
