+ 'G19':GAPS['G19'],
+ 'G22':GAPS['G22'],
+ 'G23':GAPS['G23'],
+ 'G27':GAPS['G27'],
+ 'G28':GAPS['G28'],
+ 'G29':GAPS['G29'],
+ 'G32':GAPS['G32'],
+ 'G33':GAPS['G33'],
+ 'G37':GAPS['G37'],
+ 'G39':GAPS['G39'],
+ 'G40':GAPS['G40'],
+ 'G41':GAPS['G41'],
+ 'G42':GAPS['G42'],
+ 'G44':GAPS['G44'],
+ 'G45':GAPS['G45'],
+}
