+    try:
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise RelayError("SERVICE_RUNNING", "stop the relevant service before migration/rollback") from exc
+        yield
+    finally:
+        os.close(fd)
+
